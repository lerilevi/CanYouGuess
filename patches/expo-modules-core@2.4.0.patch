+  /** Temporary build-17 diagnostic: report this exact AppContext's registration. */
+  @objc
+  public func diagnosticModuleRegistration() -> [String: Any] {
+    let bundleName = Bundle.main.infoDictionary?["CFBundleName"] as? String ?? ""
+    let qualifiedName = "\(bundleName).ExpoModulesProvider"
+    let provider = Self.modulesProvider(withName: "ExpoModulesProvider")
+    let providerClassNames = provider.getModuleClasses().map { String(reflecting: $0) }.sorted()
+    let registeredNames = moduleRegistry.getModuleNames().sorted()
+    return [
+      "bundleName": bundleName,
+      "qualifiedProviderName": qualifiedName,
+      "qualifiedProviderFound": NSClassFromString(qualifiedName) != nil,
+      "unqualifiedProviderFound": NSClassFromString("ExpoModulesProvider") != nil,
+      "selectedProviderClass": NSStringFromClass(type(of: provider)),
+      "providerClassNames": providerClassNames,
+      "registeredModuleNames": registeredNames,
+      "reactBridgePresent": reactBridge != nil,
+      "legacyProxyPresent": legacyModulesProxy != nil,
+      "appContextAddress": String(describing: Unmanaged.passUnretained(self).toOpaque())
+    ]
+  }
+
